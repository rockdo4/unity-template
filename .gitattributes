# =============================================================================
# Unity Project .gitattributes
# 줄 끝 문자(LF), Unity YAML 머지 드라이버 설정.
# (GitHub 템플릿 저장소 호환을 위해 Git LFS 미사용. 새 프로젝트에서 필요 시 별도 도입.)
#
# UnityYAMLMerge 머지 드라이버를 사용하려면 한 번만 git 설정을 등록해야 함:
#   git config --global merge.unityyamlmerge.name "Unity SmartMerge (UnityYAMLMerge)"
#   git config --global merge.unityyamlmerge.driver \
#     '"<Unity 설치 경로>/Editor/Data/Tools/UnityYAMLMerge.exe" merge -p --force --fallback none %O %B %A %A'
#   git config --global merge.unityyamlmerge.recursive binary

# -----------------------------------------------------------------------------
# 기본: 명시하지 않은 파일은 줄 끝 변환 금지
# 바이너리 또는 새 형식이 text=auto로 오인되어 손상되는 상황을 방지한다.
* -text

# 저장소 설정 파일 (LF)
.gitattributes  text eol=lf
.gitignore      text eol=lf
.editorconfig   text eol=lf
.prettierignore text eol=lf
.csharpierignore text eol=lf
.npmrc          text eol=lf

# 코드·셰이더·웹 텍스트 (LF)
*.cs           text eol=lf diff=csharp
*.csx          text eol=lf diff=csharp
*.rsp          text eol=lf
*.shader       text eol=lf
*.shadergraph  text eol=lf
*.cginc        text eol=lf
*.hlsl         text eol=lf
*.compute      text eol=lf
*.uss          text eol=lf
*.uxml         text eol=lf
*.html         text eol=lf
*.css          text eol=lf
*.scss         text eol=lf
*.js           text eol=lf
*.jsx          text eol=lf
*.mjs          text eol=lf
*.cjs          text eol=lf
*.ts           text eol=lf
*.tsx          text eol=lf
*.sh           text eol=lf
*.bash         text eol=lf
*.zsh          text eol=lf
*.py           text eol=lf
*.java         text eol=lf
*.kt           text eol=lf
*.kts          text eol=lf
*.gradle       text eol=lf

# 설정·문서·직렬화 텍스트 (LF)
*.json         text eol=lf
*.jsonc        text eol=lf
*.xml          text eol=lf
*.yaml         text eol=lf
*.yml          text eol=lf
*.toml         text eol=lf
*.ini          text eol=lf
*.cfg          text eol=lf
*.conf         text eol=lf
*.properties   text eol=lf
*.md           text eol=lf
*.txt          text eol=lf
*.csv          text eol=lf
*.tsv          text eol=lf
*.asmdef       text eol=lf
*.asmref       text eol=lf
*.inputactions text eol=lf
