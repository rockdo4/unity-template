{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": ["Read", "Edit", "Write", "Bash", "WebFetch", "WebSearch"],
    "deny": [
      "Edit(/Assets/**/*.meta)",
      "Edit(/Assets/**/*.unity)",
      "Edit(/Assets/**/*.prefab)",
      "Edit(/Assets/**/*.asset)",
      "Edit(/Assets/**/*.mat)",
      "Edit(/Assets/**/*.anim)",
      "Edit(/Assets/**/*.controller)",
      "Edit(/Assets/**/*.overrideController)",
      "Edit(/Assets/**/*.physicMaterial)",
      "Edit(/Assets/**/*.physicsMaterial2D)",
      "Edit(/Assets/**/*.playable)",
      "Edit(/Assets/**/*.mask)",
      "Edit(/Assets/**/*.brush)",
      "Edit(/Assets/**/*.flare)",
      "Edit(/Assets/**/*.fontsettings)",
      "Edit(/Assets/**/*.guiskin)",
      "Edit(/Assets/**/*.giparams)",
      "Edit(/Assets/**/*.preset)",
      "Edit(/Assets/**/*.lighting)",
      "Edit(/Assets/**/*.signal)",
      "Edit(/Assets/**/*.spriteatlas)",
      "Edit(/Assets/**/*.terrainlayer)",
      "Edit(/Packages/packages-lock.json)",
      "Edit(/ProjectSettings/**)"
    ],
    "defaultMode": "auto"
  }
}
